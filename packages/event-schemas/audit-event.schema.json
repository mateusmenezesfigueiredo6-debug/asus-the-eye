{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asus-the-eye:audit-event:1.0.0",
  "title": "ASUS THE EYE Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "idempotency_key", "tenant_id", "sequence",
    "event_type", "action", "occurred_at", "recorded_at", "actor_type",
    "actor_id_pseudonymous", "actor_role", "source_system", "resource_type",
    "resource_id_pseudonymous", "resource_version", "jurisdiction", "legal_area_ids",
    "classification", "retention_policy_id", "lawful_basis_reference",
    "content_hash_sha256", "metadata_hash_sha256", "previous_event_hash_sha256",
    "event_hash_sha256", "correlation_id", "causation_id", "model_provider",
    "model_name", "model_version", "prompt_template_version", "source_citation_hashes",
    "human_review_status", "reviewer_pseudonymous", "result_status", "error_code",
    "created_by_service", "build_version"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128, "description": "Non-personal tenant identifier"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "action": {"type": "string", "minLength": 1, "maxLength": 128},
    "occurred_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "actor_type": {"enum": ["user", "service", "agent", "system", "external"]},
    "actor_id_pseudonymous": {"$ref": "#/$defs/hash"},
    "actor_role": {"type": "string", "maxLength": 128},
    "source_system": {"type": "string", "maxLength": 128},
    "resource_type": {"type": "string", "maxLength": 128},
    "resource_id_pseudonymous": {"$ref": "#/$defs/hash"},
    "resource_version": {"type": "string", "maxLength": 64},
    "jurisdiction": {"type": "string", "maxLength": 32},
    "legal_area_ids": {"type": "array", "items": {"type": "string", "maxLength": 64}, "maxItems": 32},
    "classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "retention_policy_id": {"type": "string", "maxLength": 128},
    "lawful_basis_reference": {"type": "string", "maxLength": 256},
    "content_hash_sha256": {"$ref": "#/$defs/hash"},
    "metadata_hash_sha256": {"$ref": "#/$defs/hash"},
    "previous_event_hash_sha256": {"$ref": "#/$defs/hash"},
    "event_hash_sha256": {"$ref": "#/$defs/hash"},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "causation_id": {"type": ["string", "null"], "maxLength": 128},
    "model_provider": {"type": ["string", "null"], "maxLength": 128},
    "model_name": {"type": ["string", "null"], "maxLength": 128},
    "model_version": {"type": ["string", "null"], "maxLength": 128},
    "prompt_template_version": {"type": ["string", "null"], "maxLength": 128},
    "source_citation_hashes": {"type": "array", "items": {"$ref": "#/$defs/hash"}, "maxItems": 256},
    "human_review_status": {"enum": ["not_required", "pending", "approved", "rejected", "escalated"]},
    "reviewer_pseudonymous": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "result_status": {"enum": ["success", "failure", "partial", "denied", "tombstone"]},
    "error_code": {"type": ["string", "null"], "maxLength": 128},
    "created_by_service": {"type": "string", "maxLength": 128},
    "build_version": {"type": "string", "maxLength": 128}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
